rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // 1. GLOBAL HELPERS & DEFAULT DENY
    // -------------------------------------------------------------------------
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isVerified() { 
      return isSignedIn(); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Role-based Access Helpers (Zero-Read Custom Claims Fast Path with safe backwards-compatible fallback)
    function getUserRole() {
      return exists(/databases/$(database)/documents/employee_master/$(request.auth.uid))
             ? get(/databases/$(database)/documents/employee_master/$(request.auth.uid)).data.role
             : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
                : ((request.auth.token.role != null && request.auth.token.role is string)
                   ? request.auth.token.role
                   : 'AGENT'));
    }

    function isAdmin() {
      let isAdminEmail = request.auth.token.email != null && request.auth.token.email.lower() == 'mayank.semwal@bergtechnologies.co.in';
      let isTokenAdmin = request.auth.token.isAdmin == true ||
                         (request.auth.token.role != null && (request.auth.token.role.upper() == 'ADMIN' || request.auth.token.role.upper() == 'SYSTEM_ADMIN'));
      let dbRole = getUserRole().upper();
      let isDbAdmin = dbRole == 'ADMIN' || dbRole == 'SYSTEM_ADMIN';
      
      return isSignedIn() && (
        isAdminEmail ||
        isTokenAdmin ||
        isDbAdmin
      );
    }

    function isManager() { 
      let managerRoles = ['MANAGER', 'ASSISTANT_MANAGER', 'EXECUTIVE', 'OPS_HEAD', 'OPS HEAD', 'HR', 'HR MANAGER', 'IT_MANAGER', 'IT MANAGER', 'SUPERVISOR', 'DIRECTOR', 'VP'];
      return isAdmin() || 
             request.auth.token.isManager == true ||
             (request.auth.token.role != null && request.auth.token.role.upper() in managerRoles) ||
             (getUserRole().upper() in managerRoles);
    }

    function isSupervisor() {
      let supRoles = ['SUPERVISOR', 'OPS_HEAD', 'OPS HEAD', 'MANAGER', 'ASSISTANT_MANAGER', 'ADMIN'];
      return isManager() ||
             request.auth.token.isSupervisor == true ||
             (request.auth.token.role != null && request.auth.token.role.upper() in supRoles) ||
             (getUserRole().upper() in supRoles);
    }

    function isRole(role) { 
      return isVerified() && (
        (request.auth.token.role != null && request.auth.token.role.upper() == role) ||
        (getUserRole().upper() == role)
      ); 
    }

    function isQA() { 
      return request.auth.token.isQA == true || isRole('QA') || isManager(); 
    }

    function isTL() { 
      let tlRoles = ['TEAM_LEAD', 'STL', 'OPS_TL', 'QTL', 'TRAINER_TL', 'TRAINER', 'MIS', 'SME', 'MANAGER', 'ASSISTANT_MANAGER', 'ADMIN', 'TEAM LEAD', 'TRAINER TL', 'OPS TL', 'OPS_HEAD', 'OPS HEAD', 'HR', 'HR MANAGER', 'IT_MANAGER', 'IT MANAGER', 'SUPERVISOR'];
      return isAdmin() || 
             isManager() || 
             request.auth.token.isTeamLead == true ||
             request.auth.token.isTL == true ||
             (request.auth.token.role != null && request.auth.token.role.upper() in tlRoles) ||
             (getUserRole().upper() in tlRoles); 
    }

    function isGlobalRole() {
      let globals = ['ADMIN', 'OPS_HEAD', 'MIS', 'MANAGER', 'HR', 'IT_MANAGER', 'ASSISTANT_MANAGER', 'OPS HEAD', 'EXECUTIVE', 'DIRECTOR', 'VP', 'SUPERVISOR'];
      return isSignedIn() && (
        isAdmin() ||
        isManager() ||
        (request.auth.token.role != null && request.auth.token.role.upper() in globals) ||
        (getUserRole().upper() in globals)
      );
    }

    function isAgent() { return isRole('AGENT') || isTL() || isQA(); }

    function isITEngineer() {
      let isEngClaim = request.auth.token.isITEngineer == true;
      let role = (request.auth.token.role != null ? request.auth.token.role : (request.auth.token.isITEngineer == null ? getUserRole() : 'AGENT')).upper();
      let isEngDoc = (request.auth.token.role == null && request.auth.token.isITEngineer == null) && (
        (exists(/databases/$(database)/documents/employee_master/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/employee_master/$(request.auth.uid)).data.isITEngineer == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isITEngineer == true)
      );
      return isVerified() && (role == 'IT_MANAGER' || role == 'IT MANAGER' || role == 'IT_ENGINEER' || isEngClaim || isEngDoc);
    }
    
    // Ownership helpers
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // -------------------------------------------------------------------------
    // 2. VALIDATION HELPERS
    // -------------------------------------------------------------------------

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['ADMIN', 'MANAGER', 'ASSISTANT_MANAGER', 'QA', 'TEAM_LEAD', 'STL', 'OPS_TL', 'SME', 'QTL', 'TRAINER_TL', 'TRAINER', 'MIS', 'AGENT', 'TEAM LEAD', 'TRAINER TL', 'OPS TL', 'HR', 'IT_MANAGER', 'OPS_HEAD', 'EXECUTIVE', 'HR MANAGER', 'IT MANAGER', 'OPS HEAD'];
    }

    function isValidAudit(data) {
      return data.keys().hasAll(['id', 'taskId', 'qvName', 'quality', 'agentId', 'qaId']) &&
             data.id is string &&
             data.taskId is string &&
             data.quality is number &&
             data.agentId is string &&
             data.qaId == request.auth.uid;
    }

    function isValidWarning(data) {
      return data.keys().hasAll(['id', 'agentId', 'level', 'status', 'createdAt']) &&
             data.id is string &&
             data.agentId is string &&
             data.status in ['Pending', 'Accepted', 'Acknowledged', 'Disputed'] &&
             data.createdAt is string; // or timestamp if using serverTime
    }

    function isValidPip(data) {
      return data.keys().hasAll(['id', 'agentId', 'status', 'createdAt']) &&
             data.id is string &&
             data.agentId is string &&
             data.status in ['Initiated', 'Under Review', 'Passed', 'Failed', 'Extended'] &&
             data.createdAt is string;
    }

    // -------------------------------------------------------------------------
    // 3. COLLECTION RULES
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isVerified();
      allow list: if isVerified();
      allow create: if isVerified() && (isOwner(userId) || isAdmin() || isManager() || isRole('HR'));
      allow update: if isVerified() && (isOwner(userId) || isAdmin() || isManager() || isRole('HR') || isTL());
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAgent();
      allow create, update: if isQA();
      allow delete: if isAdmin();
    }

    match /audits/{auditId} {
      allow read: if isVerified() && (isAdmin() || isTL() || isOwner(existing().agentId) || isOwner(existing().qaId));
      allow create: if isQA() && isValidAudit(incoming());
      allow update: if isVerified() && (
        (isQA() && incoming().diff(existing()).affectedKeys().hasOnly(['quality', 'status', 'qaComment', 'errorType', 'guideline', 'theme'])) ||
        (isAgent() && isOwner(existing().agentId) && incoming().diff(existing()).affectedKeys().hasOnly(['disputeStatus', 'disputeHistory', 'isReopened'])) ||
        (isQA() && incoming().diff(existing()).affectedKeys().hasOnly(['disputeStatus', 'disputeHistory']))
      );
      allow delete: if isAdmin();
    }

    match /dailyTargets/{targetId} {
      allow read: if isVerified() && (isTL() || isAdmin() || isOwner(existing().agentId));
      allow write: if isTL() || isAdmin();
      allow delete: if isAdmin();
    }

    match /dailyPerformanceUploads/{performanceId} {
      allow read: if isVerified() && (isTL() || isAdmin() || isOwner(existing().agentId));
      allow write: if isTL() || isAdmin();
      allow delete: if isAdmin();
    }

    match /dailyPerformance/{performanceId} {
      allow read: if isVerified() && (isTL() || isAdmin() || isOwner(existing().agentId));
      allow write: if isTL() || isAdmin();
      allow delete: if isAdmin();
    }

    match /scorecards/{scorecardId} {
      allow read: if isVerified();
      allow write: if isTL() || isManager() || isAdmin();
      allow delete: if isManager() || isAdmin();
    }

    match /leaderboards/{leaderboardId} {
      allow read: if isVerified();
      allow write: if isTL() || isManager() || isAdmin();
      allow delete: if isManager() || isAdmin();
    }

    match /itTickets/{ticketId} {
      allow read: if isVerified() && (isAdmin() || isTL() || isQA() || isRole('MIS') || isITEngineer() || resource.data.employeeId == request.auth.uid || resource.data.createdBy == request.auth.uid);
      allow create: if isVerified();
      allow update: if isVerified() && (isAdmin() || isRole('MIS') || isITEngineer() || resource.data.employeeId == request.auth.uid || resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /itAssets/{assetId} {
      allow read: if isVerified() && (isAdmin() || isTL() || isRole('MIS') || isITEngineer() || resource.data.assignedUser == request.auth.uid);
      allow write: if isAdmin() || isRole('MIS') || isITEngineer();
    }

    match /itNotifications/{notifId} {
      allow read: if isVerified() && resource.data.recipientId == request.auth.uid;
      allow create: if isVerified();
      allow update: if isVerified() && resource.data.recipientId == request.auth.uid;
      allow delete: if isVerified() && resource.data.recipientId == request.auth.uid;
    }

    match /itHelpDeskConfig/{configId} {
      allow read: if isVerified();
      allow write: if isAdmin() || isRole('MIS');
    }

    match /aggregates/{id} {
      allow read: if isVerified();
      allow write: if isAdmin() || isManager() || isTL();
    }

    match /disciplinaryLogs/{logId} {
      allow read: if isVerified() && (isAdmin() || isTL() || isQA() || isOwner(existing().agentId));
      allow create: if isTL() && isValidWarning(incoming());
      allow update: if isVerified() && (isAdmin() ||
        (isOwner(existing().agentId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedAt', 'history'])) ||
        (isTL() && incoming().diff(existing()).affectedKeys().hasOnly(['remarks', 'severity', 'level', 'status', 'isDeleted', 'deletedAt', 'deletedBy']))
      );
      allow delete: if isAdmin();
    }

    match /pips/{pipId} {
      allow read: if isVerified() && (isAdmin() || isTL() || isOwner(existing().agentId));
      allow create: if isTL() && isValidPip(incoming());
      allow update: if isVerified() && (isAdmin() ||
        (isOwner(existing().agentId) && incoming().diff(existing()).affectedKeys().hasOnly(['acknowledgedByAgent', 'acknowledgedAt', 'checkins', 'signedAndAcknowledged', 'signedAndAcknowledgedAt', 'signedAndAcknowledgedBy'])) ||
        (isTL() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endDate', 'checkins', 'finalComments']))
      );
      allow delete: if isAdmin();
    }

    // System Meta Rules (Hierarchy sync versioning & system metadata)
    match /system_meta/{metaId} {
      allow read: if isVerified();
      allow write: if isVerified();
    }

    // Config Collection Rules
    match /config/{configId} {
      allow read: if isVerified();
      allow write: if isAdmin() || (isManager() && configId in ['tmsProcesses', 'processes_registry']);
    }

    match /config/master {
      allow read: if isVerified();
      allow write, delete: if isAdmin();
    }

    match /config/notificationSettings {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    match /config/attendanceSettings {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    match /process_master/{id} {
      allow read: if isVerified();
      allow write: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    match /config/alignments {
      allow read: if isVerified();
      allow write, delete: if isAdmin();
    }

    match /kpi_scorecards/{scorecardId} {
      allow read: if isVerified();
      allow write: if isVerified() && (isManager() || isAdmin() || isTL() || isRole('MIS'));
      allow delete: if isVerified() && (isManager() || isAdmin() || isRole('MIS'));
    }

    match /kpiArchive/{document=**} {
      allow read: if isVerified();
      allow write: if isVerified() && (isAdmin() || isRole('MIS') || isManager() || isTL());
      allow delete: if isVerified() && (isAdmin() || isRole('MIS') || isManager());
    }

    match /{path=**}/days/{dayProcessKey} {
      allow read: if isVerified();
      allow write: if isVerified() && (isAdmin() || isRole('MIS') || isManager() || isTL());
      allow delete: if isVerified() && (isAdmin() || isRole('MIS') || isManager());
    }

    match /kpi_templates/{id} {
      allow read: if isVerified();
      allow write: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    match /kpi_uploads/{id} {
      allow read: if isVerified();
      allow create: if isManager() || isAdmin();
      allow update: if isManager() || isAdmin();
      allow delete: if isAdmin();
    }

    match /kpi_exceptions/{id} {
      allow read: if isVerified() && isAdmin();
      allow create: if isVerified();
      allow delete: if isAdmin();
    }

    match /importantLinks/{linkId} {
      allow read: if isVerified();
      allow create, update: if isQA() || isManager() || isAdmin() || isTL();
      allow delete: if isAdmin() || isManager();
    }

    match /agent_kpis/{id} {
      allow read: if isVerified() && (isTL() || isAdmin() || isOwner(existing().agentId));
      allow write: if isAdmin() || isTL();
      allow delete: if isAdmin();
    }

    match /production/{id} {
      allow read: if isVerified() && (isTL() || isAdmin() || isOwner(existing().agentId));
      allow write: if isAdmin() || isAgent();
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isVerified() && isAdmin();
      allow write: if isVerified();
      allow delete: if isAdmin();
    }
    
    match /uploadAuditLogs/{id} {
      allow read: if isVerified() && (isAdmin() || isManager());
      allow write: if isVerified();
      allow delete: if isAdmin();
    }

    match /tmsShifts/{shiftId} {
      allow read: if isVerified();
      allow create: if isVerified() && (isTL() || isAdmin() || isOwner(incoming().userId));
      
      // Strict state machine enforcement
      allow update: if isVerified() && (isOwner(existing().userId) || isTL() || isAdmin()) && (
        
        // If current state is ACTIVE/BREAK
        (existing().status == 'ACTIVE' || existing().status == 'BREAK') ? (
          
          // Terminal transition attempt
          (incoming().status in ['COMPLETED', 'COMPLETED_FORCED', 'AUTO_CLOSED', 'CLOCKED_OUT', 'CLOSED', 'ENDED']) ? (
            
            // Only explicit allowed transitions
            (incoming().status == 'COMPLETED' && isOwner(existing().userId) && incoming().clockOutTime != null) ||
            (incoming().status == 'COMPLETED_FORCED' && (isTL() || isAdmin()))
            
            // Note: AUTO_CLOSED is strictly forbidden from client side
          ) : (
            // Non-terminal updates (heartbeats, activities, break toggle)
            // MUST NOT add a clockOutTime!
            (!incoming().keys().hasAny(['clockOutTime']) || incoming().clockOutTime == existing().clockOutTime || incoming().clockOutTime == null || incoming().clockOutTime == "")
          )
        ) : (
          // If current state is already terminal, only TLs and Admins can update (Historical Correction)
          (isTL() || isAdmin())
        )
      );
      allow delete: if isAdmin();
    }

    match /tmsActiveLocks/{userId} {
      allow read: if isVerified();
      allow write: if isVerified() && (isOwner(userId) || isTL() || isAdmin());
    }

    match /shiftRecoveryAuditLogs/{id} {
      allow read, write: if isVerified();
    }

    match /tmsHistoricalCorrections/{id} {
      allow read, write: if isVerified();
    }

    match /tmsHistoricalCorrectionJobs/{id} {
      allow read, write: if isVerified();
    }

    match /live_sessions/{uid} {
      allow read, write, delete: if isVerified();
    }

    match /live_sessions_all/{document=**} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    match /attendanceSummary/{id} {
      allow get: if isVerified() && (isTL() || isAdmin() || isOwner(existing().userId));
      allow list: if isVerified();
      allow create: if isVerified(); 
      allow update: if isVerified() && (isTL() || isAdmin() || isOwner(existing().userId));
      allow delete: if isAdmin();
    }

    match /teamMappings/{id} {
      allow read: if isVerified();
      allow create, update: if isAdmin() || isManager() || isTL();
      allow delete: if isAdmin();
    }

    match /attendanceAuditLogs/{id} {
      allow read: if isVerified() && (isTL() || isAdmin() || (resource.data.employeeEmail == request.auth.token.email));
      allow create: if isVerified();
      allow update, delete: if isAdmin();
    }

    match /dashboardSummary/{id} {
      allow read: if isVerified();
      allow write: if isTL() || isManager() || isAdmin();
    }

    match /adminAuditLogs/{id} {
      allow read: if isVerified() && isAdmin();
      allow write: if isVerified();
    }

    match /hierarchyAuditLogs/{id} {
      allow read: if isVerified() && isAdmin();
      allow write: if isVerified() && isAdmin();
    }

    match /attendance/{id} {
      allow get: if isVerified() && (isTL() || isAdmin() || isOwner(existing().userId));
      allow list: if isVerified();
      allow create: if isVerified(); 
      allow update: if isVerified() && (isTL() || isAdmin() || isOwner(existing().userId));
      allow delete: if isAdmin();
    }

    match /admin_roles_config/{id} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isVerified();
      allow write, delete: if isAdmin();
    }

    match /role_permissions/{permissionId} {
      allow read: if isVerified();
      allow write, delete: if isAdmin();
    }

    match /permission_templates/{id} {
      allow read: if isVerified();
      allow write, delete: if isAdmin();
    }

    match /module_master/{moduleId} {
      allow read: if isVerified();
      allow write, delete: if isAdmin();
    }

    match /employee_master/{id} {
      allow read: if isVerified();
      allow create, update: if isAdmin() || isManager() || isTL() || isRole('HR') || isOwner(id);
      allow delete: if isAdmin();
    }

    match /archived_records/{id} {
      allow read: if isVerified() && (isAdmin() || isManager());
      allow write, delete: if isAdmin();
    }

    match /admin_backups/{id} {
      allow read, write: if isAdmin();
      match /{allChildren=**} {
        allow read, write: if isAdmin();
      }
    }

    match /mail/{id} {
      allow create: if isVerified();
      allow read: if isVerified() && (isAdmin() || isTL() || isQA());
    }

    match /emails/{id} {
      allow create: if isVerified();
      allow read: if isVerified() && (isAdmin() || isTL() || isQA());
    }

    match /employeeProfiles/{employeeId} {
      allow read: if isVerified();
      allow create, update: if isVerified() && (isOwner(employeeId) || isAdmin() || isManager() || isRole('HR'));
      allow delete: if isAdmin();
    }

    match /kpi_scorecards/{scorecardId} {
      allow read: if isVerified();
      allow write, delete: if isTL() || isManager() || isAdmin();
    }

    match /kpiArchivePartitions/{yearMonth} {
      allow read: if isVerified();
      allow write, delete: if isTL() || isManager() || isAdmin();
    }

    match /kpiArchiveIndex/{docId} {
      allow read: if isVerified();
      allow write, delete: if isTL() || isManager() || isAdmin();
    }

    match /kpiArchive/{yearMonth} {
      allow read: if isVerified();
      allow write, delete: if isTL() || isManager() || isAdmin();

      match /employees/{employeeUid} {
        allow read: if isVerified();
        allow write, delete: if isTL() || isManager() || isAdmin();

        match /days/{dayId} {
          allow read: if isVerified() && (isAdmin() || isManager() || isTL() || isOwner(employeeUid) || resource.data.employeeEmail == request.auth.token.email);
          allow write, delete: if isTL() || isManager() || isAdmin();
        }
      }
    }

    match /{path=**}/days/{dayId} {
      allow read: if isVerified() && (isAdmin() || isManager() || isTL() || isOwner(resource.data.employeeUid) || resource.data.employeeEmail == request.auth.token.email);
      allow create, update, delete: if isTL() || isManager() || isAdmin();
    }
  }
}
