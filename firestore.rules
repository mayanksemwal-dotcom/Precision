rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // 1. GLOBAL HELPERS & DEFAULT DENY
    // -------------------------------------------------------------------------
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isVerified() { 
      return isSignedIn(); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Role-based Access Helpers
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
             : 'AGENT';
    }
    
    function isRole(role) { return isVerified() && getUserRole().upper() == role; }
    function isAdmin() {
      let isAdminEmail = request.auth.token.email != null && request.auth.token.email.lower() == 'mayank.semwal@bergtechnologies.co.in';
      return isSignedIn() && (isAdminEmail || getUserRole().upper() == 'ADMIN');
    }

    function isManager() { 
      let role = getUserRole().upper();
      return isAdmin() || role == 'MANAGER' || role == 'ASSISTANT_MANAGER' || role == 'EXECUTIVE';
    }
    function isQA() { return isRole('QA') || isManager(); }
    function isTL() { 
      let role = getUserRole().upper();
      let tlRoles = ['TEAM_LEAD', 'STL', 'OPS_TL', 'QTL', 'TRAINER_TL', 'TRAINER', 'MIS', 'SME', 'MANAGER', 'ASSISTANT_MANAGER', 'ADMIN', 'TEAM LEAD', 'TRAINER TL', 'OPS TL'];
      return isAdmin() || role in tlRoles || isManager(); 
    }
    function isAgent() { return isRole('AGENT') || isTL() || isQA(); }
    
    // Ownership helpers
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // -------------------------------------------------------------------------
    // 2. VALIDATION HELPERS
    // -------------------------------------------------------------------------

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['ADMIN', 'MANAGER', 'ASSISTANT_MANAGER', 'QA', 'TEAM_LEAD', 'STL', 'OPS_TL', 'SME', 'QTL', 'TRAINER_TL', 'TRAINER', 'MIS', 'AGENT', 'TEAM LEAD', 'TRAINER TL', 'OPS TL'];
    }

    function isValidAudit(data) {
      return data.keys().hasAll(['id', 'taskId', 'qvName', 'quality', 'agentId', 'qaId']) &&
             data.id is string &&
             data.taskId is string &&
             data.quality is number &&
             data.agentId is string &&
             data.qaId == request.auth.uid;
    }

    function isValidWarning(data) {
      return data.keys().hasAll(['id', 'agentId', 'level', 'status', 'createdAt']) &&
             data.id is string &&
             data.agentId is string &&
             data.status in ['Pending', 'Accepted', 'Acknowledged', 'Disputed'] &&
             data.createdAt is string; // or timestamp if using serverTime
    }

    function isValidPip(data) {
      return data.keys().hasAll(['id', 'agentId', 'status', 'createdAt']) &&
             data.id is string &&
             data.agentId is string &&
             data.status in ['Initiated', 'Under Review', 'Passed', 'Failed', 'Extended'] &&
             data.createdAt is string;
    }

    // -------------------------------------------------------------------------
    // 3. COLLECTION RULES
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isVerified();
      allow list: if isVerified();
      allow create: if isVerified() && (isOwner(userId) || isAdmin() || isManager());
      allow update: if isVerified() && (isOwner(userId) || isAdmin() || isManager());
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAgent();
      allow create, update: if isQA();
      allow delete: if isAdmin();
    }

    match /audits/{auditId} {
      allow read: if isVerified() && (isAdmin() || isTL() || isOwner(existing().agentId) || isOwner(existing().qaId));
      allow create: if isQA() && isValidAudit(incoming());
      allow update: if isVerified() && (
        (isQA() && incoming().diff(existing()).affectedKeys().hasOnly(['quality', 'status', 'qaComment', 'errorType', 'guideline', 'theme'])) ||
        (isAgent() && isOwner(existing().agentId) && incoming().diff(existing()).affectedKeys().hasOnly(['disputeStatus', 'disputeHistory', 'isReopened'])) ||
        (isQA() && incoming().diff(existing()).affectedKeys().hasOnly(['disputeStatus', 'disputeHistory']))
      );
      allow delete: if isAdmin();
    }

    match /dailyTargets/{targetId} {
      allow read: if isVerified() && (isTL() || isAdmin() || isOwner(existing().agentId));
      allow write: if isTL() || isAdmin();
      allow delete: if isAdmin();
    }

    match /dailyPerformanceUploads/{performanceId} {
      allow read: if isVerified() && (isTL() || isAdmin() || isOwner(existing().agentId));
      allow write: if isTL() || isAdmin();
      allow delete: if isAdmin();
    }

    match /dailyPerformance/{performanceId} {
      allow read: if isVerified() && (isTL() || isAdmin() || isOwner(existing().agentId));
      allow write: if isTL() || isAdmin();
      allow delete: if isAdmin();
    }

    match /scorecards/{scorecardId} {
      allow read: if isVerified();
      allow write: if isTL() || isManager() || isAdmin();
      allow delete: if isManager() || isAdmin();
    }

    match /leaderboards/{leaderboardId} {
      allow read: if isVerified();
      allow write: if isTL() || isManager() || isAdmin();
      allow delete: if isManager() || isAdmin();
    }

    match /disciplinaryLogs/{logId} {
      allow read: if isVerified() && (isAdmin() || isTL() || isQA() || isOwner(existing().agentId));
      allow create: if isTL() && isValidWarning(incoming());
      allow update: if isVerified() && (isAdmin() ||
        (isOwner(existing().agentId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedAt', 'history'])) ||
        (isTL() && incoming().diff(existing()).affectedKeys().hasOnly(['remarks', 'severity', 'level', 'status']))
      );
      allow delete: if isAdmin();
    }

    match /pips/{pipId} {
      allow read: if isVerified() && (isAdmin() || isTL() || isOwner(existing().agentId));
      allow create: if isTL() && isValidPip(incoming());
      allow update: if isVerified() && (isAdmin() ||
        (isOwner(existing().agentId) && incoming().diff(existing()).affectedKeys().hasOnly(['acknowledgedByAgent', 'acknowledgedAt', 'checkins', 'signedAndAcknowledged', 'signedAndAcknowledgedAt', 'signedAndAcknowledgedBy'])) ||
        (isTL() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endDate', 'checkins', 'finalComments']))
      );
      allow delete: if isAdmin();
    }

    // Config Collection Rules
    match /config/{configId} {
      allow read: if isVerified();
      allow write: if isAdmin();
      
      // Specialize rules for registry if needed
      match /processes_registry {
        allow write: if isAdmin() || isManager();
      }
      match /tmsProcesses {
        allow write: if isAdmin() || isManager();
      }
    }

    match /config/master {
      allow read: if isVerified();
      allow write, delete: if isAdmin();
    }

    match /config/notificationSettings {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    match /config/attendanceSettings {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    match /process_master/{id} {
      allow read: if isVerified();
      allow write: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    match /config/alignments {
      allow read: if isVerified();
      allow write, delete: if isAdmin();
    }

    match /kpi_templates/{id} {
      allow read: if isVerified();
      allow write: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    match /kpi_uploads/{id} {
      allow read: if isVerified();
      allow create: if isManager() || isAdmin();
      allow update: if isManager() || isAdmin();
      allow delete: if isAdmin();
    }

    match /kpi_exceptions/{id} {
      allow read: if isVerified() && isAdmin();
      allow create: if isVerified();
      allow delete: if isAdmin();
    }

    match /importantLinks/{linkId} {
      allow read: if isVerified();
      allow create, update: if isQA() || isManager() || isAdmin() || isTL();
      allow delete: if isAdmin() || isManager();
    }

    match /agent_kpis/{id} {
      allow read: if isVerified() && (isTL() || isAdmin() || isOwner(existing().agentId));
      allow write: if isAdmin() || isTL();
      allow delete: if isAdmin();
    }

    match /production/{id} {
      allow read: if isVerified() && (isTL() || isAdmin() || isOwner(existing().agentId));
      allow write: if isAdmin() || isAgent();
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isVerified() && isAdmin();
      allow write: if isVerified();
      allow delete: if isAdmin();
    }
    
    match /uploadAuditLogs/{id} {
      allow read: if isVerified() && (isAdmin() || isManager());
      allow write: if isVerified();
      allow delete: if isAdmin();
    }

    match /tmsShifts/{shiftId} {
      allow read: if isVerified() && (isTL() || isAdmin() || (resource != null && isOwner(resource.data.userId)));
      allow write: if isVerified() && (isTL() || isAdmin() || isOwner(incoming().userId) || (resource != null && isOwner(resource.data.userId)));
      allow delete: if isAdmin();
    }

    match /attendanceSummary/{id} {
      allow get: if isVerified() && (isTL() || isAdmin() || (resource != null && isOwner(resource.data.userId)));
      allow list: if isVerified();
      allow create: if isVerified(); 
      allow update: if isVerified() && (isTL() || isAdmin() || (resource != null && isOwner(resource.data.userId)));
      allow delete: if isAdmin();
    }

    match /teamMappings/{id} {
      allow read: if isVerified();
      allow create, update: if isAdmin() || isManager() || isTL();
      allow delete: if isAdmin();
    }

    match /attendanceAuditLogs/{id} {
      allow read: if isVerified() && (isTL() || isAdmin() || (resource.data.employeeEmail == request.auth.token.email));
      allow create: if isVerified();
      allow update, delete: if isAdmin();
    }

    match /dashboardSummary/{id} {
      allow read: if isVerified();
      allow write: if isTL() || isManager() || isAdmin();
    }

    match /adminAuditLogs/{id} {
      allow read: if isVerified() && isAdmin();
      allow create: if isVerified();
      allow update, delete: if isAdmin();
    }

    match /admin_roles_config/{id} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isVerified();
      allow write, delete: if isAdmin();
    }

    match /role_permissions/{permissionId} {
      allow read: if isVerified();
      allow write, delete: if isAdmin();
    }

    match /permission_templates/{id} {
      allow read: if isVerified();
      allow write, delete: if isAdmin();
    }

    match /module_master/{moduleId} {
      allow read: if isVerified();
      allow write, delete: if isAdmin();
    }

    match /employee_master/{id} {
      allow read: if isVerified();
      allow create, update: if isAdmin() || isManager() || isTL();
      allow delete: if isAdmin();
    }

    match /archived_records/{id} {
      allow read: if isVerified() && (isAdmin() || isManager());
      allow write, delete: if isAdmin();
    }

    match /admin_backups/{id} {
      allow read, write: if isAdmin();
    }

    match /mail/{id} {
      allow create: if isVerified();
      allow read: if isVerified() && (isAdmin() || isTL() || isQA());
    }

    match /emails/{id} {
      allow create: if isVerified();
      allow read: if isVerified() && (isAdmin() || isTL() || isQA());
    }
  }
}
